{
  "name": "Message",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Tenant company ID"
    },
    "lead_id": {
      "type": "string",
      "description": "Associated lead ID"
    },
    "sender_name": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "default": "inbound"
    },
    "status": {
      "type": "string",
      "enum": [
        "unread",
        "read",
        "replied"
      ],
      "default": "unread"
    },
    "ai_suggestion": {
      "type": "string",
      "description": "AI-generated reply suggestion"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "sender_name",
    "content",
    "phone"
  ]
}